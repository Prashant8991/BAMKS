# ==============================================================================
# ETHEREUM SEPOLIA TESTNET CONFIGURATION (BAMKS-D)
# ==============================================================================
# IMPORTANT: DO NOT SHARE OR COMMIT YOUR PRIVATE KEY!
# Create a copy of this file named ".env" and fill in your details.

# 1. Sepolia RPC URL (You can use Alchemy, Infura, or this free public RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 2. Your Testnet Wallet Private Key (from MetaMask -> Account Details -> Show Private Key)
# WARNING: NEVER use a real mainnet wallet! Use a dedicated testnet account with 0 real money.
SEPOLIA_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# 3. (Optional) Deployed BAMKS_Registry contract address on Sepolia
# Once deployed, paste the contract address here to interact with it.
SEPOLIA_CONTRACT_ADDRESS=
